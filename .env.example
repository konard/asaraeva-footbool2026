# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- OAuth 2.0 social login (VKontakte, Telegram, Yandex) ---
# Leave a provider's variables empty to disable it; AuthModal falls back to
# the local demo login flow for any provider that isn't configured.

# VK ID OAuth app: https://id.vk.com/business/go/docs/en/vkid/latest/vk-id/connection/create-application
# Redirect URI to register with VK: <APP_URL>/api/auth/vk/callback
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# Telegram Login Widget: https://core.telegram.org/widgets/login
# Create a bot via @BotFather, then set the domain with /setdomain to <APP_URL>.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Yandex OAuth app: https://yandex.ru/dev/id/doc/en/register-client
# Redirect URI to register with Yandex: <APP_URL>/api/auth/yandex/callback
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# SESSION_SECRET: random long string used to sign the login session cookie.
SESSION_SECRET="MY_SESSION_SECRET"

# Integram database used to store authenticated users' email, name, username
# and avatar. Leave empty to skip Integram persistence (login still works).
INTEGRAM_AUTH_DB_NAME=""
INTEGRAM_AUTH_DB_TOKEN=""
